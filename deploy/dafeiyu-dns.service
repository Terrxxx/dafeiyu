[Unit]
Description=Dafeiyu private DNS over HTTPS through server exit
Requires=dafeiyu-qq-tun.service
Wants=dafeiyu-qq-socks.service
After=dafeiyu-qq-tun.service dafeiyu-qq-socks.service
[Service]
Type=simple
User=_dnscrypt-proxy
Group=nogroup
ExecStart=/usr/sbin/dnscrypt-proxy -config /etc/dafeiyu-dns.toml
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
Restart=always
RestartSec=3
[Install]
WantedBy=multi-user.target
